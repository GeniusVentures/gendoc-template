# Wrangler configuration for the Ask AI Worker.
# The setup/deploy scripts substitute {{TOKENS}} from gendoc.yml.

name = "{{WORKER_NAME}}"
main = "gendoc-template/ask-ai/worker/src/index.ts"
compatibility_date = "{{COMPATIBILITY_DATE}}"

[vars]
LLMS_URL = "{{LLMS_URL}}"
ALLOWED_ORIGINS = "{{ALLOWED_ORIGINS}}"
SITE_URL = "{{SITE_URL}}"
BOT_NAME = "{{BOT_NAME}}"
PROVIDERS = "{{PROVIDERS}}"
GEMINI_MODEL = "{{GEMINI_MODEL}}"
OPENROUTER_MODELS = "{{OPENROUTER_MODELS}}"

# Optional Cloudflare Rate Limiting binding. Verify this syntax against the
# Wrangler version used by the repository before enabling it in production.
# [[ratelimits]]
# binding = "ASK_RATE_LIMITER"
# simple = { limit = 30, period = 60 }

# Secrets are configured separately:
#   wrangler secret put GEMINI_API_KEY
#   wrangler secret put OPENROUTER_API_KEY
