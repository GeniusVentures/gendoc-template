name: Deploy documentation

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  deploy:
    # This reusable workflow deploys the Ask AI Worker first when enabled,
    # then builds and deploys the static documentation site to Cloudflare Pages.
    uses: GeniusVentures/gendoc-template/.github/workflows/deploy.yml@develop
    with:
      template-path: gendoc-template
    secrets:
      CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
      CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
